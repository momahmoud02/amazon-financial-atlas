		displayFolder: 07 Footprint
		lineageTag: b9ae7f14-7787-43cd-acbf-1f39b99f2cc9

	measure 'Regions covered' = COALESCE ( DISTINCTCOUNT ( Dim_Market[Region] ), 0 )
		formatString: #,0
		displayFolder: 07 Footprint
		lineageTag: dc991257-2823-4170-ae09-0ea971ad5cac

	measure 'Market revenue (avg)' = COALESCE ( DIVIDE ( [Latest net sales], COUNTROWS ( ALL ( Dim_Market ) ) ), 0 )
		formatString: $#,0.0"B"
		displayFolder: 07 Footprint
		lineageTag: 7c1cb124-24a0-429c-a069-bc1242868bea

	measure 'Lat point' = COALESCE ( MAX ( Dim_Market[Latitude] ), 0 )

table Dim_Market
	lineageTag: 7e0e6771-849b-43fa-a8fb-eabc3552fd89

	measure Markets = COALESCE ( COUNTROWS ( Dim_Market ), 0 )
		formatString: #,0
		displayFolder: 07 Footprint
		lineageTag: e61a7de7-66ff-4c62-ad84-03ef0afd5ca9

	measure 'Tier 1 markets' = COALESCE ( CALCULATE ( COUNTROWS ( Dim_Market ), Dim_Market[Tier] = 1 ), 0 )
		formatString: #,0
		displayFolder: 07 Footprint
		lineageTag: 679daff8-20e6-4167-aee9-67a4700203b5

	measure 'Tier 2 markets' = COALESCE ( CALCULATE ( COUNTROWS ( Dim_Market ), Dim_Market[Tier] = 2 ), 0 )

		lineageTag: 81702b06-9ebf-470c-abf5-bf9658fc066e

	measure 'North America revenue' = COALESCE ( CALCULATE ( [Segment revenue], REMOVEFILTERS ( Dim_Segment ), Dim_Segment[Segment] = "North America" ), 0 )

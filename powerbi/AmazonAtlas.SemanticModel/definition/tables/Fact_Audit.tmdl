table Fact_Audit
	lineageTag: 37d3dbed-3417-462c-a7b2-7bb7fff429e1

	measure Corrections = COALESCE ( COUNTROWS ( Fact_Audit ), 0 )
		formatString: #,0
		displayFolder: 08 Audit
		lineageTag: 43c2b9f0-043c-4f76-a0e0-f587a1bb6a42

	measure 'Total adjustment' = COALESCE ( SUMX ( Fact_Audit, ABS ( Fact_Audit[Delta] ) ) / 1000, 0 )
		formatString: $#,0.0"B"
		displayFolder: 08 Audit
		lineageTag: 4519fb8d-3212-4fb5-a317-53fe3b56322d

	measure 'Largest adjustment' = COALESCE ( MAXX ( Fact_Audit, ABS ( Fact_Audit[Delta] ) ) / 1000, 0 )
		formatString: $#,0.0"B"
		displayFolder: 08 Audit
		lineageTag: 3ba0cd3a-5ba7-4673-a847-1504e6b2316a

	measure 'Metrics reconciled' = COALESCE ( DISTINCTCOUNT ( Fact_Audit[Metric] ), 0 )
		formatString: #,0
		displayFolder: 08 Audit
		lineageTag: d5222ec6-6b42-461d-ac65-ddc96ce7945a

	measure 'Sheets audited' = COALESCE ( DISTINCTCOUNT ( Fact_Audit[Sheet] ), 0 )
		formatString: #,0
		displayFolder: 08 Audit
		lineageTag: 14e65680-b797-4432-a621-72d81ef7636e

	measure 'Years covered' = COALESCE ( DISTINCTCOUNT ( Fact_Audit[Year] ), 0 )
		formatString: #,0
		displayFolder: 08 Audit
		lineageTag: 80a23f78-9195-4982-a664-11bfee741af9

	measure 'Workbook value shown' = COALESCE ( MAX ( Fact_Audit[Workbook value] ), 0 )

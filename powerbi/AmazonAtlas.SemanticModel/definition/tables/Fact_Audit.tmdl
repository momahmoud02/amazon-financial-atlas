		displayFolder: 08 Audit
		lineageTag: 1c2d0101-0b87-4b87-a31c-e817b4407153

	measure 'Audited value shown' = COALESCE ( MAX ( Fact_Audit[Audited value] ), 0 )
		formatString: $#,0"M"
		displayFolder: 08 Audit
		lineageTag: adc9fd00-772f-4183-a4f1-ecf4c77d3aad

	measure 'Delta shown' = COALESCE ( MAX ( Fact_Audit[Delta] ), 0 )
		formatString: +$#,0"M";-$#,0"M";"—"
		displayFolder: 08 Audit
		lineageTag: 377cfbdd-863a-4802-a0fb-4199e7f2bda7


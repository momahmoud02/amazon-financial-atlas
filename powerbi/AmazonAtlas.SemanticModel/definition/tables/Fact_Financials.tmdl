	measure 'Capex growth' = VAR p = [Capital expenditure PY] RETURN IF ( OR ( ISBLANK ( p ), p <= 0 ), 0, DIVIDE ( [Latest capital expenditure] - p, ABS ( p ) ) ) + 0
